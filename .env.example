# ─── motiva-backend/.env.example ─────────────────────────────────────────────
# Copy this file to .env and fill in every value before running locally.
# On Render, set these as Environment Variables in the service dashboard
# (never commit the real .env — it is .gitignored).

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development          # production | development
PORT=4000                     # Render injects its own PORT at runtime

# ── CORS ──────────────────────────────────────────────────────────────────────
# Full origin of the deployed frontend (no trailing slash).
# Multiple origins are not supported — use the exact Lovable / Vercel / Netlify URL.
FRONTEND_URL=http://localhost:3000

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Local:  mongodb://localhost:27017/motiva
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/motiva?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/motiva

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET
JWT_EXPIRES_IN=15m

JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_64_BYTE_HEX_SECRET
JWT_REFRESH_EXPIRES_IN=7d

# ── Cloudinary ────────────────────────────────────────────────────────────────
# Dashboard: https://console.cloudinary.com/settings/api-keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Pusher ────────────────────────────────────────────────────────────────────
# Dashboard: https://dashboard.pusher.com/apps
PUSHER_APP_ID=your_app_id
PUSHER_KEY=your_key
PUSHER_SECRET=your_secret
PUSHER_CLUSTER=eu
